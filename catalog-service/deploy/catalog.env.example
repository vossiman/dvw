# dvw-catalog environment. Copy to /opt/dvw-catalog/catalog.env on vossisrv.
# Every value has a built-in default; uncomment only what you need to change.

# Where the catalog + ssh-blueprint live. The systemd unit's ReadWritePaths
# must match this.
#CATALOG_DATA_DIR=/var/lib/dvw-catalog

# Docker API endpoint. The service has no docker-group membership; it talks to
# dvw-docker-proxy on a unix socket that systemd creates with mode 0600 for
# the service user (deploy/dvw-docker-proxy.socket, deploy/docker-proxy.md).
CATALOG_DOCKER_HOST=unix:///run/dvw-docker-proxy/docker.sock

# Optional bearer token. Leave unset for the SSH+unix-socket auth model
# (recommended for the single-user box). Set it only when more than one
# principal can reach the socket.
#CATALOG_TOKEN=

# Resolver result cache TTL (seconds). 0 disables.
#CATALOG_RESOLVE_CACHE_TTL=8

# devpod provider name stamped on catalog entries that don't carry one. Real
# catalog data overrides this per entry; it only fills the gaps.
#CATALOG_DEFAULT_PROVIDER=vossisrv

# Path to devpod agent workspace directories on this box. Each workspace's
# build source (clone checkout) is <dir>/<id>/content. "~" expands to the
# service account's home (vossi on vossisrv).
#CATALOG_DEVPOD_AGENT_WORKSPACES_DIR=~/.devpod/agent/contexts/default/workspaces

# URL of an explicitly immutable canonical blueprint devcontainer.json from
# aiCodingBaseSetup. When unset, the service invokes `aicoding-select
# aicoding`, supplied by the minimal common updater in ~/.local/bin, and fetches
# the returned exact SHA. The selector also needs gh, jq and timeout. If you
# override this, use exactly the raw GitHub SHA URL shown below. Moving refs,
# other paths, queries and fragments are rejected.
#CATALOG_BLUEPRINT_DEVCONTAINER_URL=https://raw.githubusercontent.com/vossiman/aiCodingBaseSetup/0123456789abcdef0123456789abcdef01234567/devcontainer.json

# Blueprint image comparison cache TTL (seconds). Set to 0 to fetch on every
# request instead of serving a cached value; every request then serializes
# on the fetch (one lock, one network round trip), so avoid 0 on busy boxes.
#CATALOG_BLUEPRINT_IMAGE_TTL=900

# Where dvw-catalog-backup.timer pushes /var/lib/dvw-catalog nightly (a
# private GitHub repo; gh-token-helper supplies the token from the shared
# secrets store). host-install.sh and host-update.sh set it as origin. Unset
# leaves the repo's git config alone: with no origin every push fails with
# "no configured push destination", which is what happened silently until
# 2026-09-08 (DVW-15); a hand-configured origin stays in use, and the
# scripts say so.
#CATALOG_BACKUP_REMOTE=https://github.com/vossiman/dvw-catalog-data.git

# Kuma push monitor for the nightly dvw-catalog-backup.timer. The unit GETs
# this URL only after `git push` succeeded, so a stopped timer or a failing
# push shows up as a silent monitor. Create the monitor in Kuma (type Push,
# interval about 26 h) and paste its push URL here; never commit the value.
#CATALOG_BACKUP_PUSH_URL=

# Durable record of activity state changes and idle-countdown resets, written
# under CATALOG_DATA_DIR and served by GET /v1/containers/activity/history.
# Only changes are recorded, so a steady fleet writes almost nothing. Set the
# filename empty to disable recording; the file rotates once at the size cap.
#CATALOG_ACTIVITY_HISTORY_FILENAME=activity-history.jsonl
#CATALOG_ACTIVITY_HISTORY_MAX_BYTES=2097152

# Root log level. uvicorn configures only its own loggers, so without this the
# service's own INFO records never reach the journal.
#CATALOG_LOG_LEVEL=info
