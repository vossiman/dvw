[Unit]
Description=dvw catalog backup (git commit + push of the data dir)
After=dvw-catalog.service

[Service]
Type=oneshot
# User/Group default to vossi; host-install.sh rewrites them to the installing
# account, so the unit isn't tied to a specific user.
User=vossi
Group=vossi
WorkingDirectory=/var/lib/dvw-catalog
# Optional CATALOG_BACKUP_PUSH_URL (a Kuma push monitor). The file is the
# service's own env file; a missing file is fine.
EnvironmentFile=-/opt/dvw-catalog/catalog.env
# /var/lib/dvw-catalog is a git repo (host-install.sh inits it once).
# Commits are no-ops when nothing changed; the push is best-effort so a
# missing/unreachable remote never fails the unit. The Kuma heartbeat goes
# out only after a successful push: a push that fails, or a timer that never
# fires, leaves the monitor silent, which is the signal (DVW-14).
# `$$` hands the shell a literal `${CATALOG_BACKUP_PUSH_URL}` to expand from its
# environment inside the quotes; a plain `${...}` would have systemd paste
# the URL into the shell source before parsing, and a URL containing `$` or
# `$(` would be expanded or executed by the shell (codex review, PR #74).
ExecStart=/bin/sh -c 'git add -A && (git diff --cached --quiet || git commit -q -m "snapshot $(date -Iseconds)")'
ExecStart=/bin/sh -c 'if git push --quiet; then [ -z "$${CATALOG_BACKUP_PUSH_URL:-}" ] || curl -fsS -m 15 "$${CATALOG_BACKUP_PUSH_URL}" >/dev/null || echo "kuma heartbeat failed"; else echo "git push failed; no heartbeat sent"; fi'
