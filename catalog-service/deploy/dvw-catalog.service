[Unit]
Description=dvw catalog service (DevPod workspace catalog + container resolver)
Documentation=https://github.com/vossiman/dvw
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=exec
# User/Group default to vossi; host-install.sh rewrites them to the installing
# account, so the unit isn't tied to a specific user.
User=vossi
Group=vossi
# NO SupplementaryGroups=docker. The service reaches Docker through
# dvw-docker-proxy instead, over /run/dvw-docker-proxy/docker.sock
# (see deploy/docker-proxy.md), configured via CATALOG_DOCKER_HOST. Do not
# re-add the group; if Docker is unreachable, check the proxy.

WorkingDirectory=/opt/dvw-catalog
Environment=PYTHONUNBUFFERED=1
Environment=PATH=/home/vossi/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
EnvironmentFile=-/opt/dvw-catalog/catalog.env

# Bind uvicorn to a unix socket — no TCP port is ever opened on the box.
# systemd creates/owns /run/dvw-catalog (0750, vossi:vossi); UMask makes the
# socket 0660 so only processes running as vossi (i.e. an SSH-authenticated
# session) can connect.
RuntimeDirectory=dvw-catalog
RuntimeDirectoryMode=0750
UMask=0117
ExecStart=/opt/dvw-catalog/.venv/bin/uvicorn app.main:app \
    --uds /run/dvw-catalog/catalog.sock \
    --no-access-log \
    --workers 1

Restart=on-failure
RestartSec=2
TimeoutStopSec=10

# --- Hardening (must not break docker access) ---
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/dvw-catalog
# The source-pull endpoint (POST /v1/workspaces/{id}/source/pull) fast-forwards
# devpod source clones under ~/.devpod/agent, writing both .git and the
# working tree; without this, ProtectHome=read-only fails it. A customized
# CATALOG_DEVPOD_AGENT_WORKSPACES_DIR needs a matching ReadWritePaths entry.
#
# NOT %h: in a SYSTEM unit that specifier is the service manager's home,
# i.e. /root, and User= does not change it. Combined with the "-" prefix
# (which tolerates an absent dir) it granted /root/.devpod/agent and failed
# silently, so every pull died on "cannot open '.git/FETCH_HEAD':
# Read-only file system". The installers rewrite this line for the running
# user the same way they rewrite User=.
ReadWritePaths=-/home/vossi/.devpod/agent
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
# AF_UNIX: the service's own listen socket and the dvw-docker-proxy socket.
# AF_INET/AF_INET6: two consumers still need outbound TCP. app/blueprint_image.py
# does urllib urlopen(raw.githubusercontent.com) for the pin-staleness check
# (it logs refresh failures and serves the last qualified cached value, or
# degrades to "unknown" until one is available). app/source.py runs
# `git pull` as a child process for POST /source/pull, which inherits this
# seccomp filter.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
# multi-user.target: normal boot.
# docker.service: Requires=docker.service (above) propagates STOP but not
# START, so a `systemctl restart docker` would otherwise leave this service
# dead until someone noticed. This reverse Wants brings it back up with
# docker. Both symlinks are written at `systemctl enable`/`reenable` time;
# changing this line only reaches an installed host via `reenable`.
WantedBy=multi-user.target docker.service
