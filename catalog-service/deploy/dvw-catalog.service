[Unit]
Description=dvw catalog service (DevPod workspace catalog + container resolver)
Documentation=https://github.com/vossiman/dvw
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=exec
# User/Group default to vossi; host-install.sh rewrites them to the installing
# account, so the unit isn't tied to a specific user.
User=vossi
Group=vossi
# NO SupplementaryGroups=docker. The service reaches Docker through the
# digest-pinned socket proxy instead (deploy/docker-proxy.compose.yml),
# configured via CATALOG_DOCKER_HOST. Do not re-add the group; if Docker is
# unreachable, start the proxy.
#
# Be clear about what that swap buys: the proxy narrows the API surface
# (no /images, /volumes, /networks, /build), so a compromised catalog can
# reach less. It does NOT remove host-root equivalence — CONTAINERS plus POST
# still permits creating a container with an arbitrary bind mount. And it
# trades a group-gated socket for an unauthenticated loopback TCP port, which
# any local account can reach. See deploy/docker-socket-proxy.md.

WorkingDirectory=/opt/dvw-catalog
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/opt/dvw-catalog/catalog.env

# Bind uvicorn to a unix socket — no TCP port is ever opened on the box.
# systemd creates/owns /run/dvw-catalog (0750, vossi:vossi); UMask makes the
# socket 0660 so only processes running as vossi (i.e. an SSH-authenticated
# session) can connect.
RuntimeDirectory=dvw-catalog
RuntimeDirectoryMode=0750
UMask=0117
ExecStart=/opt/dvw-catalog/.venv/bin/uvicorn app.main:app \
    --uds /run/dvw-catalog/catalog.sock \
    --no-access-log \
    --workers 1

Restart=on-failure
RestartSec=2
TimeoutStopSec=10

# --- Hardening (must not break docker access) ---
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/dvw-catalog
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
# AF_UNIX: local docker socket + the service's own listen socket.
# AF_INET/AF_INET6: required ONLY when CATALOG_DOCKER_HOST points at the
# docker-socket-proxy over tcp://127.0.0.1.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
# multi-user.target: normal boot.
# docker.service: Requires=docker.service (above) propagates STOP but not
# START, so a `systemctl restart docker` would otherwise leave this service
# dead until someone noticed. This reverse Wants brings it back up with
# docker. Both symlinks are written at `systemctl enable`/`reenable` time;
# changing this line only reaches an installed host via `reenable`.
WantedBy=multi-user.target docker.service
