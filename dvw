#!/usr/bin/env bash
# dvw — DevPod workspace orchestrator. See devpod/README.md.
set -euo pipefail

DVW_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
# Optional per-machine config (catalog host / provider). Loaded BEFORE the libs
# so it can set DVW_* values the libs then fall back on. env > file > default.
# shellcheck source=lib/config.sh
. "$DVW_ROOT/lib/config.sh"
dvw_load_config
# shellcheck source=lib/catalog.sh
. "$DVW_ROOT/lib/catalog.sh"
# shellcheck source=lib/ssh-sync.sh
. "$DVW_ROOT/lib/ssh-sync.sh"
# shellcheck source=lib/wsl-bridge.sh
. "$DVW_ROOT/lib/wsl-bridge.sh"
# shellcheck source=lib/connect.sh
. "$DVW_ROOT/lib/connect.sh"
# Service-backed overrides for the resolver/probe functions. MUST come after
# connect.sh so its definitions win.
# shellcheck source=lib/connect-resolver.sh
. "$DVW_ROOT/lib/connect-resolver.sh"
# shellcheck source=lib/push.sh
. "$DVW_ROOT/lib/push.sh"
# shellcheck source=lib/commands.sh
. "$DVW_ROOT/lib/commands.sh"
# shellcheck source=lib/wizard.sh
. "$DVW_ROOT/lib/wizard.sh"
# pin.sh reuses wizard.sh's blueprint fetch — source it after.
# shellcheck source=lib/pin.sh
. "$DVW_ROOT/lib/pin.sh"
# shellcheck source=lib/ui.sh
. "$DVW_ROOT/lib/ui.sh"
# shellcheck source=lib/update-check.sh
. "$DVW_ROOT/lib/update-check.sh"
# shellcheck source=lib/update-super.sh
. "$DVW_ROOT/lib/update-super.sh"
# shellcheck source=lib/tui-launch.sh
. "$DVW_ROOT/lib/tui-launch.sh"

main() {
  # Pull out --dry-run (anywhere in argv) before subcommand dispatch.
  # Mutating shellouts (devpod up/delete/stop, docker restart) flowing
  # through _dvw_run_or_print print "would run: ..." instead of executing.
  # Direct catalog mutations gate on DVW_DRY_RUN inline.
  local arg filtered=()
  for arg in "$@"; do
    if [[ "$arg" == "--dry-run" ]]; then
      export DVW_DRY_RUN=1
    else
      filtered+=("$arg")
    fi
  done
  set -- "${filtered[@]}"

  # TUI plumbing: `dvw new --list-branches|--check-devcontainer` are pure git
  # probes whose STDOUT is a machine-read contract (line 1 = the resolved URL)
  # and whose exit code carries meaning (0/1/2/3). Dispatch them BEFORE the
  # update nudge (which printfs to stdout when the checkout is behind main)
  # and before the three ui_progress pre-flights (catalog/ssh/wsl: they emit
  # progress markers and can exit 1, which would masquerade as "devcontainer
  # missing"). Same shape as the `dvw config` special case below.
  if [[ "${1:-}" == new && ( "${2:-}" == "--list-branches" || "${2:-}" == "--check-devcontainer" ) ]]; then
    shift; cmd_new "$@"; return $?
  fi

  if [[ "${DVW_DRY_RUN:-}" == "1" ]]; then
    ui_info "[dry-run] no commands will be executed; would-be invocations are printed"
  fi

  # Update notifier: kick a throttled background fetch, then print the cached
  # "behind main" nudge (suppressed for `dvw update` itself). Fail-open.
  dvw_update_refresh_if_stale
  dvw_update_maybe_nudge "${1:-}"

  # `dvw config` must work even when the catalog is unreachable — it's how you
  # fix a wrong host — so handle it before the reachability gate below.
  if [[ "${1:-}" == config ]]; then
    shift; cmd_config "$@"; return $?
  fi

  ui_progress "checking catalog"        catalog_init_if_missing || exit 1
  ui_progress "syncing ssh blueprint"   ssh_sync_refresh
  ui_progress "syncing wsl bridge"      wsl_bridge_refresh

  case "${1:-}" in
    -l|--list)
      cmd_list ;;
    new)
      shift
      if (($# == 0)); then
        if _dvw_tui_available; then
          local tui_rc=0
          DVW_TUI_START=new dvw_tui_launch || tui_rc=$?
          [[ $tui_rc -ne 0 ]] && ui_error "TUI exited with rc=$tui_rc"
          exit "$tui_rc"
        fi
        ui_error "dvw new without flags opens the TUI wizard — unavailable here: $(_dvw_tui_unavailable_reason)"
        _new_usage
        exit 1
      fi
      cmd_new "$@" ;;
    rm)
      shift; cmd_rm "$@" ;;
    update)
      shift; cmd_update "$@" ;;
    stop)
      shift; cmd_stop "$@" ;;
    start)
      shift; cmd_start "$@" ;;
    recreate|rebuild)
      shift; cmd_recreate "$@" ;;
    pin-sync)
      shift; cmd_pin_sync "$@" ;;
    status)
      cmd_status ;;
    attach)
      shift; cmd_attach "$@" ;;
    push)
      shift; cmd_push "$@" ;;
    doctor)
      cmd_doctor ;;
    audit)
      cmd_orphans_audit ;;
    "")
      if _dvw_tui_available; then
        local tui_rc=0
        dvw_tui_launch || tui_rc=$?
        if [[ $tui_rc -ne 0 ]]; then
          ui_error "TUI exited with rc=$tui_rc"
        fi
        exit "$tui_rc"
      else
        ui_error "the dvw TUI is unavailable — $(_dvw_tui_unavailable_reason)"
        ui_info "subcommands: <id> | attach | push | new | rm | stop | start | recreate | pin-sync | update | status | doctor | audit | config | -l"
        exit 1
      fi ;;
    *)
      cmd_connect "$@" ;;
  esac
}

# Sourceable for tests: only dispatch when executed directly.
if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
